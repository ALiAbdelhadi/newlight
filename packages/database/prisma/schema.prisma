// Newlight schema v2.
//
// Amendments to the BUILD spec that this file implements are recorded in
// docs/schema-v2-amendments.md; where the two disagree, that file wins.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Taxonomy
//
// Exactly two levels: Category -> SubCategory. CategoryType is gone; top-level
// categories are ordinary rows. Slugs live on the translation rows, unique per
// (locale, slug), so Arabic and English URLs are independent (§9.2).
// ---------------------------------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  imageUrl  String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  translations  CategoryTranslation[]
  subCategories SubCategory[]
  discounts     Discount[]

  @@index([isActive, order])
  @@index([deletedAt])
  @@map("categories")
}

model CategoryTranslation {
  id              String   @id @default(cuid())
  categoryId      String
  locale          String
  slug            String
  name            String
  description     String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("category_translations")
}

model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  imageUrl   String?
  order      Int       @default(0)
  isActive   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category     Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations SubCategoryTranslation[]
  families     ProductFamily[]
  products     Product[]
  specs        SubCategorySpec[]
  discounts    Discount[]

  @@index([categoryId, order])
  @@index([deletedAt])
  @@map("sub_categories")
}

model SubCategoryTranslation {
  id              String   @id @default(cuid())
  subCategoryId   String
  locale          String
  slug            String
  name            String
  description     String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([subCategoryId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("sub_category_translations")
}

// ---------------------------------------------------------------------------
// Product families (§6)
//
// Replaces Product.baseProductId / Product.variantType. Grouping comes from the
// verified production baseProductId during the transform; no runtime regex.
// ---------------------------------------------------------------------------

model ProductFamily {
  id            String    @id @default(cuid())
  subCategoryId String
  slug          String    @unique
  variantType   String?
  order         Int       @default(0)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subCategory  SubCategory                @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  translations ProductFamilyTranslation[]
  products     Product[]
  discounts    Discount[]

  @@index([subCategoryId, order])
  @@index([deletedAt])
  @@map("product_families")
}

model ProductFamilyTranslation {
  id              String   @id @default(cuid())
  familyId        String
  locale          String
  slug            String
  name            String
  description     String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("product_family_translations")
}

// ---------------------------------------------------------------------------
// Product
//
// Only identity and state remain as columns. Everything descriptive moved to
// ProductSpec (§2.1); colours moved to the ProductColor lookup (§8); images
// moved to ProductImage (§5). colorTemperatures stays — it is state, not a spec.
// ---------------------------------------------------------------------------

model Product {
  id            String  @id @default(cuid())
  productId     String  @unique // editable business SKU
  slug          String  @unique // shared across locales (§9.3)
  subCategoryId String
  familyId      String?

  variantValue String?
  displayOrder Int     @default(0)

  price       Decimal  @db.Decimal(12, 2)
  averageCost Decimal? @db.Decimal(12, 2) // null until real cost data exists (§13.6)

  colorTemperatures ProductColorTemp[]

  isActive   Boolean   @default(true)
  isFeatured Boolean   @default(false)
  order      Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  subCategory     SubCategory             @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  family          ProductFamily?          @relation(fields: [familyId], references: [id], onDelete: SetNull)
  translations    ProductTranslation[]
  images          ProductImage[]
  specs           ProductSpec[]
  availableColors ProductAvailableColor[]
  slugHistory     ProductSlugHistory[]
  stockMovements  StockMovement[]
  stockLevels     StockLevel[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  configurations  ProductConfiguration[]
  users           User[]                  @relation("UserToProduct")
  discounts       DiscountProduct[]

  @@index([subCategoryId])
  @@index([familyId, displayOrder])
  @@index([isActive, isFeatured])
  @@index([deletedAt])
  @@index([price])
  @@map("products")
}

model ProductTranslation {
  id              String   @id @default(cuid())
  productId       String
  locale          String
  name            String
  description     String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

// ---------------------------------------------------------------------------
// Media (§5)
//
// order = 0 is the primary image. There is deliberately no isPrimary flag, so
// nothing can mutate primacy independently of ordering.
// ---------------------------------------------------------------------------

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  publicId    String
  order       Int      @default(0)
  colorId     String?
  width       Int?
  height      Int?
  blurDataUrl String?
  altEn       String?
  altAr       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId, order])
  @@index([colorId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Colours (§8)
//
// Replaces the AvailableColors enum. Keys are preserved exactly (BLACK, GRAY,
// WHITE, GOLD, WOOD) because cart and order snapshots reference them.
// ---------------------------------------------------------------------------

model ProductColor {
  id        String   @id @default(cuid())
  key       String   @unique
  hex       String
  nameEn    String
  nameAr    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductAvailableColor[]
  images   ProductImage[]

  @@map("product_colors")
}

model ProductAvailableColor {
  productId String
  colorId   String
  order     Int    @default(0)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([productId, colorId])
  @@index([colorId])
  @@map("product_available_colors")
}

// ---------------------------------------------------------------------------
// Normalised specifications (§7)
//
// unitEn / unitAr rather than a single unit column: `hours` / `ساعة` cannot
// share one (amendment A2). Symbol units simply repeat, which is honest.
// ---------------------------------------------------------------------------

enum SpecValueType {
  NUMBER
  TEXT
  BOOLEAN

  @@map("spec_value_type")
}

model SpecDefinition {
  key       String        @id
  valueType SpecValueType
  unitEn    String?
  unitAr    String?
  labelEn   String
  labelAr   String
  order     Int           @default(0)

  subCategories SubCategorySpec[]
  productSpecs  ProductSpec[]

  @@index([order])
  @@map("spec_definitions")
}

model SubCategorySpec {
  subCategoryId String
  specKey       String
  required      Boolean @default(false)
  order         Int     @default(0)

  subCategory SubCategory    @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  spec        SpecDefinition @relation(fields: [specKey], references: [key], onDelete: Cascade)

  @@id([subCategoryId, specKey])
  @@index([specKey])
  @@map("sub_category_specs")
}

model ProductSpec {
  id          String   @id @default(cuid())
  productId   String
  specKey     String
  valueNumber Decimal? @db.Decimal(12, 3)
  valueEn     String?
  valueAr     String?
  valueBool   Boolean?

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  spec    SpecDefinition @relation(fields: [specKey], references: [key], onDelete: Cascade)

  @@unique([productId, specKey])
  @@index([specKey, valueNumber])
  @@index([specKey, valueEn])
  @@map("product_specs")
}

// ---------------------------------------------------------------------------
// Slug history (§10) — old URLs resolve to 301s.
// ---------------------------------------------------------------------------

model ProductSlugHistory {
  id        String   @id @default(cuid())
  productId String
  slug      String   @unique
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_slug_history")
}

enum TaxonomyEntityType {
  CATEGORY
  SUB_CATEGORY
  PRODUCT_FAMILY

  @@map("taxonomy_entity_type")
}

model TaxonomySlugHistory {
  id         String             @id @default(cuid())
  locale     String
  slug       String
  entityType TaxonomyEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  @@unique([locale, slug])
  @@index([entityType, entityId])
  @@map("taxonomy_slug_history")
}

// ---------------------------------------------------------------------------
// Audit (§11)
//
// Also the order-transition history. actorType (F1) makes every transition
// attributable to a customer, an admin, the system, or — once Bosta lands — a
// courier webhook, without backfilling history that was never recorded.
// ---------------------------------------------------------------------------

enum ActorType {
  CUSTOMER
  ADMIN
  SYSTEM
  WEBHOOK

  @@map("actor_type")
}

model AdminAuditLog {
  id         String     @id @default(cuid())
  actorType  ActorType?
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String
  diff       Json?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// Users, cart, orders
// ---------------------------------------------------------------------------

// Identity is Better Auth's (§7). name / emailVerified / image are its required fields;
// role is ours, and is what finally makes UserRole a column rather than nine scattered
// comparisons against an ADMIN_EMAIL environment variable.
model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  emailVerified     Boolean  @default(false)
  image             String?
  role              UserRole @default(CUSTOMER)
  phoneNumber       String?
  preferredLanguage String   @default("ar")
  preferredCurrency String   @default("EGP")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  configurationId   String?
  productId         String?
  shippingAddressId String?  @unique

  configuration   ProductConfiguration? @relation("ConfigurationToUser", fields: [configurationId], references: [id])
  product         Product?              @relation("UserToProduct", fields: [productId], references: [id])
  shippingAddress ShippingAddress?
  cart            Cart?
  orders          Order[]
  sessions        Session[]
  accounts        Account[]

  // Browser push endpoints. Cascade, because a deleted user's endpoints are dead mail:
  // pushing to them can only ever produce a 410 from the push service.
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

// The three tables Better Auth owns. Their shape is dictated by its Prisma adapter — the
// field names are not ours to choose — but they are declared HERE so there is one schema and
// one migration history (§7). The Better Auth CLI never generates a migration.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  // The password hash for the credential provider. Better Auth owns the hashing.
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Email-verification and password-reset tokens. Short-lived; swept by expiry.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id                String            @id @default(cuid())
  cartId            String
  productId         String
  quantity          Int               @default(1)
  selectedColorTemp ProductColorTemp?
  selectedColorKey  String? // stable ProductColor.key, not a foreign key (snapshot semantics)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, selectedColorTemp, selectedColorKey])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id                String        @id @default(cuid())
  userId            String
  orderNumber       String        @unique
  idempotencyKey    String        @unique
  subtotal          Decimal       @db.Decimal(12, 2)
  shippingCost      Decimal       @db.Decimal(12, 2)
  tax               Decimal?      @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  status            OrderStatus   @default(awaiting_shipment)
  shippingOption    OrderOption   @default(StandardShipping)
  paymentMethod     PaymentMethod @default(COD)
  paymentStatus     PaymentStatus @default(PENDING)
  paidAt            DateTime? // set only by settlePaymentForDelivery (F4)
  shippingAddressId String?
  trackingNumber    String? // manually entered under COD (F3)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  customerNotes     String?
  adminNotes        String?
  configurationId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items           OrderItem[]
  shippingAddress ShippingAddress? @relation(fields: [shippingAddressId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuration   ProductConfiguration? @relation("ConfigurationToOrder", fields: [configurationId], references: [id])

  @@index([userId])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  productId         String
  productName       String
  productImage      String
  price             Decimal           @db.Decimal(12, 2) // immutable snapshot (§24.4)
  quantity          Int
  selectedColorTemp ProductColorTemp?
  selectedColorKey  String?
  configurationId   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  configuration ProductConfiguration? @relation("ConfigurationToOrderItem", fields: [configurationId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model ShippingAddress {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  phone        String
  email        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String   @default("Egypt")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("shipping_addresses")
}

// Live session state for the configure flow, so a real foreign key is correct
// here; productSku is a denormalised copy so a configuration stays readable if
// the product is later soft-deleted (Q4).
//
// priceIncrease / shippingPrice / discount are gone: 0.00 on all 13 production
// rows and never written with anything else. A money column that is always zero
// is a promise the checkout does not keep.
model ProductConfiguration {
  id                String   @id @default(cuid())
  productId         String
  productSku        String
  configPrice       Decimal  @db.Decimal(12, 2)
  totalPrice        Decimal  @db.Decimal(12, 2)
  quantity          Int
  currency          String   @default("EGP")
  selectedColorTemp String?
  selectedColorKey  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orders     Order[]     @relation("ConfigurationToOrder")
  users      User[]      @relation("ConfigurationToUser")
  orderItems OrderItem[] @relation("ConfigurationToOrderItem")

  @@index([productId])
  @@index([createdAt])
  @@map("product_configurations")
}

// ---------------------------------------------------------------------------
// Inventory ledger (§13)
//
// Append-only movements plus a derived level. packages/database/inventory.ts is
// the only writer; movement insert and level update share one transaction.
// ---------------------------------------------------------------------------

enum MovementType {
  INITIAL
  PURCHASE_RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE

  @@map("movement_type")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements   StockMovement[]
  stockLevels StockLevel[]

  @@map("locations")
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  locationId    String
  type          MovementType
  quantity      Int
  unitCost      Decimal?     @db.Decimal(12, 2) // null means "cost not recorded", never zero
  reason        String?
  referenceType String?
  referenceId   String?
  actorType     ActorType?
  actorId       String?
  createdAt     DateTime     @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([productId, locationId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
  @@map("stock_movements")
}

model StockLevel {
  productId  String
  locationId String
  onHand     Int      @default(0)
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([productId, locationId])
  @@index([locationId])
  @@map("stock_levels")
}

// ---------------------------------------------------------------------------
// Contact forms, notifications, settings — carried over unchanged.
// ---------------------------------------------------------------------------

model ContactForm {
  id          String            @id @default(cuid())
  fullName    String
  jobPosition String
  email       String
  phoneNumber String
  message     String?
  status      ContactFormStatus @default(UNREAD)
  source      String            @default("website")
  ipAddress   String?
  userAgent   String?
  isRead      Boolean           @default(false)
  readAt      DateTime?
  readBy      String?
  priority    ContactPriority   @default(NORMAL)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  responses ContactFormResponse[]
  tags      ContactFormTag[]

  @@index([status, createdAt])
  @@index([isRead])
  @@index([email])
  @@index([createdAt])
  @@map("contact_forms")
}

model ContactFormResponse {
  id            String      @id @default(cuid())
  contactFormId String
  adminId       String
  message       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contactForm   ContactForm @relation(fields: [contactFormId], references: [id], onDelete: Cascade)

  @@index([contactFormId])
  @@map("contact_form_responses")
}

model ContactFormTag {
  id            String      @id @default(cuid())
  contactFormId String
  tag           String
  createdAt     DateTime    @default(now())
  contactForm   ContactForm @relation(fields: [contactFormId], references: [id], onDelete: Cascade)

  @@unique([contactFormId, tag])
  @@map("contact_form_tags")
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  actionUrl String?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  priority  NotificationPriority @default(NORMAL)
  metadata  Json?
  expiresAt DateTime?

  /// NULL means "the push sweep has not handled this row yet".
  ///
  /// This is what makes the Notification table its own push outbox, exactly as EmailOutbox is
  /// the mail one: the row is written inside the business transaction, and the delivery
  /// happens after it. An order that commits always has its notification; a push service that
  /// is unreachable can never roll back an order. Set once the fan-out has been attempted —
  /// success or permanent failure — so a sweep does not re-push a notification an admin has
  /// already seen.
  pushedAt DateTime?

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type])
  // The sweep's claim predicate: unpushed rows, oldest first.
  @@index([pushedAt, createdAt])
  @@map("notifications")
}

/// One browser push endpoint belonging to one user (§17).
///
/// Not a resurrection of the v1 channel deleted in A8. That one queried a table production did
/// not have, from a service worker that never subscribed. This is subscribed to by the admin
/// shell, keyed on the endpoint the browser issues, and pruned by the sweep whenever the push
/// service answers 404 or 410 — the only two statuses that mean "this endpoint is gone", as
/// opposed to "try again later".
model PushSubscription {
  id String @id @default(cuid())

  userId String

  /// The push service's URL for this browser. Unique because a re-subscribe from the same
  /// browser must UPDATE the row rather than accumulate duplicates that all deliver to the
  /// same place — which is how one notification becomes four.
  endpoint String @unique

  /// The two halves of the Web Push encryption key material, exactly as
  /// `PushSubscription.toJSON().keys` gives them.
  p256dh String
  auth   String

  /// So a person can tell "my laptop" from "my phone" when revoking one.
  userAgent String?

  /// Consecutive transport failures that were NOT a hard 404/410. A subscription that fails
  /// this many times in a row is stale in practice even if the push service will not say so.
  failureCount  Int       @default(0)
  lastSuccessAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Transactional email (§16)
//
// The outbox row is written in the SAME TRANSACTION as the business event that
// causes it, then dispatched afterwards. That is the whole point: an order that
// commits always has its confirmation queued, and a mail transport that is down
// can never roll back an order.
// ---------------------------------------------------------------------------

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED

  @@map("email_status")
}

model EmailOutbox {
  id       String      @id @default(cuid())
  template String
  to       String
  locale   String
  payload  Json
  status   EmailStatus @default(PENDING)

  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime? // set by the sweep when a send fails; NULL means "ready now"
  sentAt        DateTime?

  // "the confirmation for order X", so a retried business event queues one email
  // rather than one per attempt. NULL for mail that is legitimately repeatable,
  // such as a second password-reset request.
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("email_outbox")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductColorTemp {
  WARM_3000K
  COOL_4000K
  WHITE_6500K

  @@map("product_color_temp")
}

enum OrderOption {
  BasicShipping
  StandardShipping
  ExpressShipping

  @@map("order_option")
}

// processing / fulfilled / refunded are gone: no production row ever used them
// and no live code assigns them (§12).
enum OrderStatus {
  awaiting_shipment
  shipped
  delivered
  cancelled

  @@map("order_status")
}

enum PaymentMethod {
  COD

  @@map("payment_method")
}

// PAID means money received by the merchant, nothing weaker. COLLECTED and
// SETTLED are the additive path when a courier lands (F4).
enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED

  @@map("payment_status")
}

enum ContactFormStatus {
  UNREAD
  READ
  IN_PROGRESS
  RESPONDED
  CLOSED
  SPAM

  @@map("contact_form_status")
}

enum ContactPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("contact_priority")
}

enum NotificationType {
  NEW_CONTACT_FORM
  NEW_ORDER
  ORDER_CANCELLED
  LOW_INVENTORY
  SYSTEM_ALERT
  CUSTOM

  @@map("notification_type")
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("notification_priority")
}

/// Shared rate-limit counters.
///
/// The contact form kept these in a module-level `Map`, which is per-instance and resets on
/// every cold start — on serverless that is close to no rate limit at all, on the one
/// unauthenticated write endpoint the storefront exposes. A row is the only state every
/// instance can agree on.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Discounts (§13.2, amendment A21 follow-up)
//
// A21 dropped `ProductConfiguration.discount` because three always-zero money columns
// advertised a capability the checkout never had, and said that when discounts arrived they
// should be DESIGNED rather than inherited. This is that design.
//
// A discount is an OVERLAY, never a write to `products.price`:
//
//   - the base price is what the product costs; a discount is a period during which it costs
//     less. Writing the sale price into the column destroys the "was" half of "was 1000, now
//     850", and there is then nothing to restore when the period ends;
//   - the end of a discount is a fact about time, not a job that has to run. Nothing has to
//     fire at midnight for a discount to expire, so nothing can fail to fire; and
//   - bulk repricing stays what it is — a permanent price change, audited as one. A seasonal
//     sale run through it would put fifteen days of noise in every product's price history.
//
// packages/database/pricing.ts is the ONLY resolver. Both apps read effective prices through
// it, because a storefront showing 850 while the checkout charges 1000 is the defect this
// table would otherwise introduce.
// ---------------------------------------------------------------------------

enum DiscountKind {
  /// `value` is a percentage of the base price: 15 means 15% off.
  PERCENT
  /// `value` is an amount off in the store currency.
  AMOUNT

  @@map("discount_kind")
}

/// What a discount is pointed at. One discount, one target — the join table exists only so
/// that PRODUCTS can name several SKUs without needing several discounts.
enum DiscountScopeType {
  ALL
  CATEGORY
  SUB_CATEGORY
  FAMILY
  PRODUCTS

  @@map("discount_scope_type")
}

model Discount {
  id    String       @id @default(cuid())
  /// Internal label. Never rendered to a customer: the storefront shows "−15%", not a name
  /// that would then need a translation row and a locale fallback of its own.
  name  String
  kind  DiscountKind
  value Decimal      @db.Decimal(12, 2)

  scopeType     DiscountScopeType
  categoryId    String?
  subCategoryId String?
  familyId      String?

  /// The window, in UTC, half-open: `startsAt <= now < endsAt`. Half-open so a discount that
  /// ends on the 15th and one that starts on the 15th cannot both be live for one instant.
  startsAt DateTime
  endsAt   DateTime

  /// The kill switch. Ending a discount early sets this false rather than deleting the row:
  /// an order placed at the discounted price has to stay explicable afterwards.
  isActive Boolean @default(true)

  /// Who created it. Denormalised like AdminAuditLog's actor columns, for the same reason —
  /// the answer must survive the admin account being deleted.
  createdById    String?
  createdByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory SubCategory?      @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  family      ProductFamily?    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  products    DiscountProduct[]

  /// The resolver's only query: live rows whose window contains now.
  @@index([isActive, startsAt, endsAt])
  @@index([scopeType])
  @@map("discounts")
}

/// The SKUs a PRODUCTS-scoped discount names.
model DiscountProduct {
  discountId String
  productId  String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_products")
}
